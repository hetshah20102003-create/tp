# Telephony
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# STT options
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxx
SARVAM_STT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxx

# LLM options
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxx

# TTS options
SARVAM_TTS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxx
AZURE_SPEECH_KEY=xxxxxxxxxxxxxxxxxxxxxxx
AZURE_SPEECH_REGION=centralindia

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/worryq_voice

# Google Sheets (service account JSON path)
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-sa.json

# App config
PORT=3000
MAX_CONCURRENT_CALLS=5
CALLS_PER_MINUTE=10
